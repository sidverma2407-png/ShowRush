# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seatzy?schema=public"

# Authentication
JWT_SECRET="seatzy_production_jwt_secret_key_2026"

# Server & Routing
PORT=3000
FRONTEND_URL="http://localhost:5173"
HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15

# ─────────────────────────────────────────────
# SMTP Email Configuration
# Recommended provider: Brevo (free 300 emails/day, works on Render)
# Sign up: https://app.brevo.com → SMTP & API → Generate SMTP Key
#
# Brevo settings:
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your_brevo_login_email@gmail.com"
SMTP_PASS="your_brevo_smtp_key_here"
EMAIL_FROM="Seatzy Tickets <your_brevo_login_email@gmail.com>"
#
# Alternative: Gmail (may have IPv6 issues on Render free tier)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="yourmail@gmail.com"
# SMTP_PASS="16_char_app_password_no_spaces"
# EMAIL_FROM="Seatzy Tickets <yourmail@gmail.com>"
# ─────────────────────────────────────────────
